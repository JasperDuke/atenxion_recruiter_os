{
  "openapi": "3.0.3",
  "info": {
    "title": "Atenxion Recruiter OS Callback API",
    "description": "Inbound callback endpoints for Atenxion job specification polishing and candidate intelligence evaluation.",
    "version": "1.0.0",
    "contact": { "name": "Atenxion Recruiter OS Support" }
  },
  "servers": [
    { "url": "https://YOUR_PUBLIC_APPLICATION_DOMAIN", "description": "Replace with the public Recruiter OS application domain" }
  ],
  "paths": {
    "/api/callbacks/job-polish": {
      "post": {
        "summary": "Receive a polished job specification",
        "description": "Atenxion calls this endpoint after completing a job_polish task. The event_id must match the job polish event previously dispatched by Recruiter OS.",
        "operationId": "receiveJobPolishCallback",
        "tags": ["Callbacks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JobPolishCallback" },
              "example": {
                "event_id": "job_spec_981a20",
                "status": "completed",
                "polishedJob": {
                  "roleTitle": "Lead Distributed Systems Engineer",
                  "executiveSummary": "We are seeking a seasoned systems engineer to design, scale, and optimize high-throughput distributed architectures.",
                  "responsibilities": ["Architect and maintain fault-tolerant event streams with Apache Kafka.", "Implement consensus mechanisms using Raft and low-latency RPC protocols in Go."],
                  "coreQualifications": ["5+ years engineering backend distributed platforms.", "Deep mastery of Go concurrency primitives and memory profiling."],
                  "preferredExperience": ["Production-grade deployment of Kubernetes operators.", "Experience with zero-downtime database partition migrations."]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job polish callback stored successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallbackAcceptedResponse" }, "example": { "received": true } } }
          },
          "400": { "description": "The callback is not completed or polishedJob is missing" },
          "404": { "description": "The event_id does not match a known job polish event" }
        }
      }
    },
    "/api/callbacks/candidate-eval": {
      "post": {
        "summary": "Receive a candidate intelligence dossier",
        "description": "Atenxion calls this endpoint after completing a resume_eval task. The event_id must match the candidate evaluation event previously dispatched by Recruiter OS.",
        "operationId": "receiveCandidateEvaluationCallback",
        "tags": ["Callbacks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CandidateEvaluationCallback" },
              "example": {
                "event_id": "eval_77a92c30",
                "status": "completed",
                "intelligenceDossier": {
                  "overallScore": 89,
                  "fitRating": "Strong Fit",
                  "executiveSummary": "Candidate presents 6 years of focused systems programming in Go, matching the low-latency infrastructure requirements closely.",
                  "skillsAnalysis": { "verifiedSkills": ["Go", "Kafka", "Docker", "PostgreSQL", "gRPC"], "missingOrUnclearSkills": ["Raft consensus protocol", "Kubernetes Operator SDK"], "adjacentSkills": ["Redis clustering", "Prometheus telemetry"] },
                  "experienceTrajectory": { "totalRelevantYears": 6, "seniorityTier": "Senior / Lead Track", "tenureStability": "High — average 2.5 years per role" },
                  "candidateStrengths": ["Proven track record scaling event message pipelines to 250k msgs/sec.", "Strong systems architecture focus."],
                  "criticalGapsAndRedFlags": ["No direct mention of consensus algorithms in production.", "Limited discussion of incident remediation or on-call leadership."],
                  "interviewProbeQuestions": ["Can you walk us through a scenario where a Kafka broker partition lost synchronization?", "How have you handled state reconciliation in distributed systems without two-phase commit?"]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate evaluation callback stored successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallbackAcceptedResponse" }, "example": { "received": true } } }
          },
          "400": { "description": "The callback is not completed or intelligenceDossier is missing" },
          "404": { "description": "The event_id does not match a known candidate evaluation event" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallbackAcceptedResponse": {
        "type": "object",
        "required": ["received"],
        "properties": { "received": { "type": "boolean", "example": true } }
      },
      "JobPolishCallback": {
        "type": "object",
        "required": ["event_id", "status", "polishedJob"],
        "properties": {
          "event_id": { "type": "string", "description": "The event_id from the original job_polish dispatch.", "example": "job_spec_981a20" },
          "status": { "type": "string", "enum": ["completed"], "example": "completed" },
          "polishedJob": { "$ref": "#/components/schemas/PolishedJob" }
        }
      },
      "PolishedJob": {
        "type": "object",
        "required": ["roleTitle", "executiveSummary", "responsibilities", "coreQualifications", "preferredExperience"],
        "properties": {
          "roleTitle": { "type": "string" },
          "executiveSummary": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "coreQualifications": { "type": "array", "items": { "type": "string" } },
          "preferredExperience": { "type": "array", "items": { "type": "string" } }
        }
      },
      "CandidateEvaluationCallback": {
        "type": "object",
        "required": ["event_id", "status", "intelligenceDossier"],
        "properties": {
          "event_id": { "type": "string", "description": "The event_id from the original resume_eval dispatch.", "example": "eval_77a92c30" },
          "status": { "type": "string", "enum": ["completed"], "example": "completed" },
          "intelligenceDossier": { "$ref": "#/components/schemas/IntelligenceDossier" }
        }
      },
      "IntelligenceDossier": {
        "type": "object",
        "required": ["overallScore", "fitRating", "executiveSummary", "skillsAnalysis", "experienceTrajectory", "candidateStrengths", "criticalGapsAndRedFlags", "interviewProbeQuestions"],
        "properties": {
          "overallScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "fitRating": { "type": "string" },
          "executiveSummary": { "type": "string" },
          "skillsAnalysis": { "$ref": "#/components/schemas/SkillsAnalysis" },
          "experienceTrajectory": { "$ref": "#/components/schemas/ExperienceTrajectory" },
          "candidateStrengths": { "type": "array", "items": { "type": "string" } },
          "criticalGapsAndRedFlags": { "type": "array", "items": { "type": "string" } },
          "interviewProbeQuestions": { "type": "array", "items": { "type": "string" } }
        }
      },
      "SkillsAnalysis": {
        "type": "object",
        "required": ["verifiedSkills", "missingOrUnclearSkills", "adjacentSkills"],
        "properties": {
          "verifiedSkills": { "type": "array", "items": { "type": "string" } },
          "missingOrUnclearSkills": { "type": "array", "items": { "type": "string" } },
          "adjacentSkills": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ExperienceTrajectory": {
        "type": "object",
        "required": ["totalRelevantYears", "seniorityTier", "tenureStability"],
        "properties": {
          "totalRelevantYears": { "type": "number" },
          "seniorityTier": { "type": "string" },
          "tenureStability": { "type": "string" }
        }
      }
    }
  },
  "tags": [
    { "name": "Callbacks", "description": "Asynchronous Atenxion result callbacks." }
  ]
}
