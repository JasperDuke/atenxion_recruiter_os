{
  "openapi": "3.0.3",
  "info": {
    "title": "Atenxion Recruiter OS API",
    "description": "Talent intelligence and candidate orchestration API for job polishing, resume evaluation, recruiter dossiers, application decisions, and candidate status visibility.",
    "version": "1.0.0",
    "contact": {
      "name": "Atenxion Recruiter OS Support"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Recruiter OS deployment"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns a lightweight unauthenticated health response.",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "ok": true }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Read engine configuration",
        "description": "Returns the persisted Atenxion connection status and public application domain. The bearer token is never returned.",
        "tags": ["Configuration"],
        "responses": {
          "200": {
            "description": "Configuration fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConfigResponse" },
                "example": {
                  "configured": true,
                  "atenxionUrl": "https://backend.atenxion.ai",
                  "publicAppUrl": "https://recruiter.example.com",
                  "updatedAt": "2026-10-08 10:30:00"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save engine configuration",
        "description": "Persists the Atenxion agent URL, bearer token, and public application domain. URLs are normalized by trimming whitespace and trailing slashes.",
        "tags": ["Configuration"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfigRequest" },
              "example": {
                "atenxionUrl": "https://backend.atenxion.ai/",
                "atenxionToken": "bearer-token-value",
                "publicAppUrl": "https://recruiter.example.com/"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration saved successfully",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigResponse" } } }
          },
          "400": { "description": "A configured URL does not start with http:// or https://" }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List jobs",
        "description": "Returns published jobs by default. Set includeDrafts=true for the admin workspace list.",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "includeDrafts", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": {
            "description": "Jobs returned",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } } } }
          }
        }
      },
      "post": {
        "summary": "Create a draft job",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateJobRequest" },
              "example": {
                "draftTitle": "Lead Distributed Systems Engineer",
                "rawSummary": "Need someone who knows Go, Kafka, and Raft consensus. 5+ years experience. Fully remote."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft job created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } }
          },
          "400": { "description": "draftTitle and rawSummary are required" }
        }
      }
    },
    "/api/jobs/{jobId}": {
      "get": {
        "summary": "Read a job",
        "tags": ["Jobs"],
        "parameters": [ { "$ref": "#/components/parameters/JobId" } ],
        "responses": {
          "200": { "description": "Job returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } },
          "404": { "description": "Job was not found" }
        }
      },
      "put": {
        "summary": "Save reviewed job content",
        "description": "Updates the editable polished job specification before it is published.",
        "tags": ["Jobs"],
        "parameters": [ { "$ref": "#/components/parameters/JobId" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateJobRequest" } } }
        },
        "responses": {
          "200": { "description": "Job content saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } },
          "400": { "description": "roleTitle and executiveSummary are required" },
          "404": { "description": "Job was not found" }
        }
      }
    },
    "/api/jobs/{jobId}/polish": {
      "post": {
        "summary": "Dispatch job polish",
        "description": "Sends a job_polish task to the configured Atenxion trigger endpoint. The completed result is received asynchronously at /api/callbacks/job-polish.",
        "tags": ["Jobs"],
        "parameters": [ { "$ref": "#/components/parameters/JobId" } ],
        "responses": {
          "200": {
            "description": "Job polish dispatched",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DispatchResponse" }, "example": { "dispatched": true, "eventId": "job_spec_981a20" } } }
          },
          "404": { "description": "Job was not found" },
          "502": { "description": "Atenxion dispatch failed or engine configuration is incomplete" }
        }
      }
    },
    "/api/jobs/{jobId}/publish": {
      "post": {
        "summary": "Publish a reviewed job",
        "description": "Publishes a job after its role title and executive summary have been reviewed. Published jobs appear in the applicant portal.",
        "tags": ["Jobs"],
        "parameters": [ { "$ref": "#/components/parameters/JobId" } ],
        "responses": {
          "200": { "description": "Job published", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } },
          "400": { "description": "The job is not ready for publishing" }
        }
      }
    },
    "/api/jobs/{jobId}/applications": {
      "get": {
        "summary": "List applications for a job",
        "description": "Returns the admin candidate board for a role, including stored intelligence dossiers.",
        "tags": ["Applications"],
        "parameters": [ { "$ref": "#/components/parameters/JobId" } ],
        "responses": {
          "200": { "description": "Applications returned", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Application" } } } } }
        }
      }
    },
    "/api/applications": {
      "post": {
        "summary": "Submit a candidate application",
        "description": "Stores a PDF or DOCX resume, creates a pending application, and dispatches a resume_eval task to Atenxion. The evaluation result is received asynchronously at /api/callbacks/candidate-eval.",
        "tags": ["Applications"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ApplicationRequest" },
              "encoding": { "resume": { "contentType": "application/pdf, application/vnd.openxmlformats-officedocument.wordprocessingml.document" } }
            }
          }
        },
        "responses": {
          "201": { "description": "Application submitted and evaluation dispatched", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } } },
          "400": { "description": "Required candidate fields are missing or the resume is invalid" },
          "404": { "description": "The role is not published" },
          "409": { "description": "The candidate already applied to this role with this email" },
          "502": { "description": "Atenxion dispatch failed" }
        }
      }
    },
    "/api/applications/{applicationId}": {
      "get": {
        "summary": "Read an application and dossier",
        "tags": ["Applications"],
        "parameters": [ { "$ref": "#/components/parameters/ApplicationId" } ],
        "responses": {
          "200": { "description": "Application returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } } },
          "404": { "description": "Application was not found" }
        }
      }
    },
    "/api/applications/{applicationId}/decision": {
      "patch": {
        "summary": "Set a candidate pipeline decision",
        "description": "Sets pending, review, selected, or rejected. A decision reason is required for selected and rejected.",
        "tags": ["Applications"],
        "parameters": [ { "$ref": "#/components/parameters/ApplicationId" } ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DecisionRequest" }, "example": { "status": "selected", "decisionReason": "Strong systems design match; advancing to technical interview.", "decisionFeedback": "We will contact you with scheduling options." } } }
        },
        "responses": {
          "200": { "description": "Decision saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Application" } } } },
          "400": { "description": "Invalid status or missing final decision reason" },
          "404": { "description": "Application was not found" }
        }
      }
    },
    "/api/candidate/applications": {
      "get": {
        "summary": "View applications by candidate email",
        "description": "Returns the candidate's applications. Dossier details remain hidden while the application is pending or under review and are included only after selected or rejected is set.",
        "tags": ["Candidate Portal"],
        "parameters": [ { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "format": "email" } } ],
        "responses": {
          "200": { "description": "Candidate applications returned", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Application" } } } } },
          "400": { "description": "Email is required" }
        }
      }
    },
    "/api/callbacks/job-polish": {
      "post": {
        "summary": "Receive a completed job polish callback",
        "description": "Stores the polished job specification for the matching job polish event and marks the job ready for admin review.",
        "tags": ["Callbacks"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobPolishCallback" } } }
        },
        "responses": {
          "200": { "description": "Callback stored", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallbackResponse" } } } },
          "400": { "description": "Callback was not completed or polishedJob is missing" },
          "404": { "description": "event_id does not match a job polish event" }
        }
      }
    },
    "/api/callbacks/candidate-eval": {
      "post": {
        "summary": "Receive a completed candidate evaluation callback",
        "description": "Stores the intelligence dossier for the matching application and keeps its pipeline status pending until an admin reviews it.",
        "tags": ["Callbacks"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CandidateEvaluationCallback" } } }
        },
        "responses": {
          "200": { "description": "Callback stored", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallbackResponse" } } } },
          "400": { "description": "Callback was not completed or intelligenceDossier is missing" },
          "404": { "description": "event_id does not match a candidate evaluation event" }
        }
      }
    },
    "/files/resumes/{filename}": {
      "get": {
        "summary": "Download an uploaded resume",
        "description": "Returns a publicly accessible uploaded PDF or DOCX resume attachment.",
        "tags": ["Attachments"],
        "parameters": [ { "$ref": "#/components/parameters/ResumeFilename" } ],
        "responses": {
          "200": { "description": "Resume file", "content": { "application/pdf": {}, "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {} } },
          "404": { "description": "Resume file was not found" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^job_[a-f0-9]+$" } },
      "ApplicationId": { "name": "applicationId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^app_[a-f0-9]+$" } },
      "ResumeFilename": { "name": "filename", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9-]+\\.(pdf|docx)$" } }
    },
    "schemas": {
      "HealthResponse": { "type": "object", "required": ["ok"], "properties": { "ok": { "type": "boolean", "example": true } } },
      "ConfigRequest": {
        "type": "object",
        "properties": {
          "atenxionUrl": { "type": "string", "format": "uri", "description": "Atenxion agent API base URL." },
          "atenxionToken": { "type": "string", "writeOnly": true, "description": "Bearer token used for Atenxion dispatch." },
          "publicAppUrl": { "type": "string", "format": "uri", "description": "Public application domain used in callback and resume URLs." }
        }
      },
      "ConfigResponse": {
        "type": "object",
        "required": ["configured", "atenxionUrl", "publicAppUrl"],
        "properties": {
          "configured": { "type": "boolean" },
          "atenxionUrl": { "type": "string" },
          "publicAppUrl": { "type": "string" },
          "updatedAt": { "type": "string", "nullable": true }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "required": ["draftTitle", "rawSummary"],
        "properties": {
          "draftTitle": { "type": "string", "minLength": 1 },
          "rawSummary": { "type": "string", "minLength": 1 }
        }
      },
      "UpdateJobRequest": {
        "type": "object",
        "required": ["roleTitle", "executiveSummary"],
        "properties": {
          "roleTitle": { "type": "string" },
          "executiveSummary": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "coreQualifications": { "type": "array", "items": { "type": "string" } },
          "preferredExperience": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Job": {
        "type": "object",
        "required": ["id", "draftTitle", "rawSummary", "status", "createdAt"],
        "properties": {
          "id": { "type": "string", "example": "job_981a20" },
          "draftTitle": { "type": "string" },
          "rawSummary": { "type": "string" },
          "roleTitle": { "type": "string", "nullable": true },
          "executiveSummary": { "type": "string", "nullable": true },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "coreQualifications": { "type": "array", "items": { "type": "string" } },
          "preferredExperience": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["draft", "polishing", "ready_for_review", "published"] },
          "polishEventId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string" },
          "publishedAt": { "type": "string", "nullable": true }
        }
      },
      "DispatchResponse": {
        "type": "object",
        "required": ["dispatched", "eventId"],
        "properties": { "dispatched": { "type": "boolean" }, "eventId": { "type": "string" } }
      },
      "ApplicationRequest": {
        "type": "object",
        "required": ["jobId", "fullName", "email", "resume"],
        "properties": {
          "jobId": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "resume": { "type": "string", "format": "binary", "description": "PDF or DOCX file, maximum 10 MB." }
        }
      },
      "DecisionRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["pending", "review", "selected", "rejected"] },
          "decisionReason": { "type": "string", "description": "Required when status is selected or rejected." },
          "decisionFeedback": { "type": "string" }
        }
      },
      "Application": {
        "type": "object",
        "required": ["id", "jobId", "jobTitle", "candidateId", "candidateName", "candidateEmail", "status", "appliedAt"],
        "properties": {
          "id": { "type": "string", "example": "app_77a92c30" },
          "jobId": { "type": "string" },
          "jobTitle": { "type": "string" },
          "candidateId": { "type": "string" },
          "candidateName": { "type": "string" },
          "candidateEmail": { "type": "string", "format": "email" },
          "resumeOriginalName": { "type": "string" },
          "resumeUrl": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "review", "selected", "rejected"] },
          "appliedAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "decisionReason": { "type": "string" },
          "decisionFeedback": { "type": "string" },
          "dossier": { "$ref": "#/components/schemas/IntelligenceDossier", "nullable": true }
        }
      },
      "IntelligenceDossier": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "overallScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "fitRating": { "type": "string" },
          "executiveSummary": { "type": "string" },
          "skillsAnalysis": { "$ref": "#/components/schemas/SkillsAnalysis" },
          "experienceTrajectory": { "$ref": "#/components/schemas/ExperienceTrajectory" },
          "candidateStrengths": { "type": "array", "items": { "type": "string" } },
          "criticalGapsAndRedFlags": { "type": "array", "items": { "type": "string" } },
          "interviewProbeQuestions": { "type": "array", "items": { "type": "string" } }
        }
      },
      "SkillsAnalysis": {
        "type": "object",
        "properties": {
          "verifiedSkills": { "type": "array", "items": { "type": "string" } },
          "missingOrUnclearSkills": { "type": "array", "items": { "type": "string" } },
          "adjacentSkills": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ExperienceTrajectory": {
        "type": "object",
        "properties": {
          "totalRelevantYears": { "type": "number" },
          "seniorityTier": { "type": "string" },
          "tenureStability": { "type": "string" }
        }
      },
      "JobPolishCallback": {
        "type": "object",
        "required": ["event_id", "status", "polishedJob"],
        "properties": {
          "event_id": { "type": "string" },
          "status": { "type": "string", "example": "completed" },
          "polishedJob": {
            "type": "object",
            "required": ["roleTitle", "executiveSummary"],
            "properties": {
              "roleTitle": { "type": "string" },
              "executiveSummary": { "type": "string" },
              "responsibilities": { "type": "array", "items": { "type": "string" } },
              "coreQualifications": { "type": "array", "items": { "type": "string" } },
              "preferredExperience": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "CandidateEvaluationCallback": {
        "type": "object",
        "required": ["event_id", "status", "intelligenceDossier"],
        "properties": {
          "event_id": { "type": "string" },
          "status": { "type": "string", "example": "completed" },
          "intelligenceDossier": { "$ref": "#/components/schemas/IntelligenceDossier" }
        }
      },
      "CallbackResponse": {
        "type": "object",
        "required": ["received"],
        "properties": { "received": { "type": "boolean", "example": true } }
      }
    }
  },
  "tags": [
    { "name": "System", "description": "Service health endpoints." },
    { "name": "Configuration", "description": "Persisted Atenxion engine settings." },
    { "name": "Jobs", "description": "Job drafting, polishing, review, and publishing." },
    { "name": "Applications", "description": "Candidate applications, dossiers, and decisions." },
    { "name": "Candidate Portal", "description": "Candidate application status and gated results." },
    { "name": "Callbacks", "description": "Asynchronous Atenxion result callbacks." },
    { "name": "Attachments", "description": "Public resume attachments." }
  ]
}
